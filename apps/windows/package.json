{
  "name": "forge-game-center-windows",
  "version": "1.0.0",
  "description": "Forge Game Center standalone para Windows",
  "author": "Forge Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.forge.gamecenter",
    "productName": "Forge Game Center",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Forge-Game-Center-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
